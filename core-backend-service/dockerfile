# ====================================================================
# Etapa 1: Compilación del Fat JAR (Builder)
# ====================================================================
FROM maven:3.9.9-eclipse-temurin-21-alpine AS builder

WORKDIR /app

# 1. Copiamos pom.xml y descargamos dependencias para aprovechar la caché de Docker
COPY pom.xml ./
RUN mvn dependency:go-offline -B

# 2. Copiamos el código fuente y empaquetamos el JAR (sin ejecutar tests en el build)
COPY src ./src
RUN mvn clean package -DskipTests

# ====================================================================
# Etapa 2: Runtime de Producción (JRE 21 mínimo y seguro)
# ====================================================================
FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

# Crear usuario seguro no privilegiado
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Copiar el JAR generado desde la etapa de compilación
COPY --from=builder /app/target/*.jar app.jar

USER appuser

EXPOSE 8085

# Parámetros optimizados para contenedores (Headless y memoria dinámica)
ENTRYPOINT ["java", "-XX:+UseContainerSupport", "-jar", "app.jar"]