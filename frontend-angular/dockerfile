# ====================================================================
# Etapa 1: Compilación de la aplicación Angular (Builder)
# ====================================================================
FROM node:22-alpine AS builder

WORKDIR /app

# Copiamos manifiestos y descargamos dependencias aprovechando la caché
COPY package*.json ./
RUN npm ci

# Copiamos el código fuente y compilamos para producción
COPY . .
RUN npm run build -- --configuration=production

# ====================================================================
# Etapa 2: Servidor Web Nginx de Producción (Ultraligero)
# ====================================================================
FROM nginx:alpine

# Copiamos la configuración personalizada de Nginx
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copiamos los archivos compilados de Angular al directorio público de Nginx
COPY --from=builder /app/dist/frontend-angular/browser /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]