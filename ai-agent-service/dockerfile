# ====================================================================
# Etapa 1: Builder (Instalación ultrarrápida con uv)
# ====================================================================
FROM ghcr.io/astral-sh/uv:0.5.21-python3.12-bookworm-slim AS builder
WORKDIR /app

# Habilitar compilación de bytecode y optimizaciones
ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy

# 1. Copiamos manifiestos de dependencias primero para aprovechar la caché de Docker
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --no-dev

# 2. Copiamos el código fuente de la aplicación
COPY app ./app
COPY main.py ./

# Sincronizamos la instalación del proyecto en el entorno virtual
RUN uv sync --frozen --no-dev

# ====================================================================
# Etapa 2: Runtime de Producción (Ligero, limpio y seguro)
# ====================================================================

FROM python:3.12-slim-bookworm
WORKDIR /app

# Crear usuario seguro sin privilegios de root
RUN useradd -m -u 1000 appuser

# Copiamos solo el entorno virtual y la aplicación desde el builder
COPY --from=builder --chown=appuser:appuser /app /app
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
USER appuser
EXPOSE 8000
# Arrancamos Uvicorn escuchando en todas las interfaces de red del contenedor
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]